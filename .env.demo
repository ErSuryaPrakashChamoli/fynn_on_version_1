SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
#QUEUE_CONNECTION=sync

# Uploaded documents are moved to the "local" disk on save (see
# OcrDocumentForm's FileUpload::disk('local')). Livewire otherwise stages
# temporary uploads on FILESYSTEM_DISK ("public") by default, so every
# create click had to synchronously stream-copy the whole file across disks
# (up to 500MB) before the request could even return. Staging on the same
# disk lets Filament take its instant move()/rename() fast path instead.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Laravel's database queue driver defaults retry_after to 90s — it
# considers a job "abandoned" and lets ANOTHER worker pick it up again
# once that elapses, even if the original worker is still legitimately
# running it. App\Jobs\ProcessOcrDocument routinely takes several minutes
# per page on a large scan, so every job was getting duplicated onto a
# second worker mid-run: doubled CPU load, two temp directories for the
# same document, and eventual "attempted too many times" failures once
# both copies burned through their retries. Must stay >
# ProcessOcrDocument::$timeout (3600s).
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OCR engine: "python" (PaddleOCR-based, default) or "tesseract" (legacy
# in-app pipeline, kept for rollback). See config/laravel-ocr.php.
OCR_ENGINE=python
# Dedicated virtualenv built from python/ocr/requirements.txt (Python 3.11
# via `uv python install 3.11`, venv at python/ocr/.venv) — NOT system
# python3, which has no cv2/paddleocr and isn't a supported interpreter
# version for the paddlepaddle wheels.
PYTHON_OCR_BINARY=/home/administrator/Documents/fynn_on_live/fynn_on_version_1/python/ocr/.venv/bin/python3
PYTHON_OCR_TIMEOUT=1800

VITE_APP_NAME="${APP_NAME}"

# --- Demo sandbox (see config/demo.php) ---
SESSION_COOKIE=fynn_on_demo_session
CACHE_PREFIX=fynn_on_demo_
DEMO_MODE=true
DEMO_PASSWORD=Demo@123
