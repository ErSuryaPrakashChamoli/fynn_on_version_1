# Client demo environment: the real /admin panel running against its own
# database of seeded sample data. Copy to .env.demo, then:
#
#   php artisan key:generate --env=demo
#   php artisan demo-environment:refresh --env=demo --force
#   APP_ENV=demo php artisan serve --port=8010
#
# APP_ENV=demo makes Laravel load .env.demo instead of .env.
APP_NAME=Laravel
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=fynn_on_demo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OCR engine: "python" (PaddleOCR-based, default) or "tesseract" (legacy
# in-app pipeline, kept for rollback). See config/laravel-ocr.php.
OCR_ENGINE=python
# Point at the python3 inside the dedicated OCR virtualenv, NOT system python3.
PYTHON_OCR_BINARY=/usr/bin/python3
# PYTHON_OCR_SCRIPT=/absolute/path/to/python/ocr/ocr_engine.py
PYTHON_OCR_TIMEOUT=1800

VITE_APP_NAME="${APP_NAME}"

# --- Demo sandbox (see config/demo.php) ---
# Cookies are not isolated by port, so the demo needs its own session
# cookie or signing in to it would sign the same browser out of /admin.
SESSION_COOKIE=fynn_on_demo_session
CACHE_PREFIX=fynn_on_demo_
DEMO_MODE=true
DEMO_PASSWORD=Demo@123
